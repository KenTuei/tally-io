# ============================================================
# Tally.io — .gitignore
# ============================================================

# ----- Environment & secrets --------------------------------
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*secret*
*credential*

# ----- Node.js ----------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# ----- Build outputs ----------------------------------------
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
*.tsbuildinfo

# ----- Vite -------------------------------------------------
vite.config.ts.timestamp-*

# ----- TypeScript -------------------------------------------
*.js.map
*.d.ts.map

# ----- Test coverage ----------------------------------------
coverage/
.nyc_output/
lcov.info
*.lcov

# ----- Logs -------------------------------------------------
logs/
*.log
npm-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ----- OS generated -----------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ----- IDE / editor -----------------------------------------
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
!.vscode/extensions.json.example
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.c9/
*.launch

# ----- Tauri desktop ----------------------------------------
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/WixTools/
apps/desktop/src-tauri/Cargo.lock
*.AppImage
*.deb
*.msi
*.exe
*.dmg

# ----- Capacitor mobile -------------------------------------
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.gradle/

# ----- Docker -----------------------------------------------
.docker/

# ----- Database dumps ---------------------------------------
*.dump
*.sql
*.bson
*.mongodump/
mongo-data/

# ----- Certificates and SSL ---------------------------------
*.cert
ssl/
certs/

# ----- Uploads and user content -----------------------------
uploads/
media/
public/uploads/

# ----- Temporary files --------------------------------------
tmp/
temp/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ----- Package manager lock files (keep root lockfile) ------
# pnpm-lock.yaml is tracked at the root
# individual package lock files are not needed
apps/*/package-lock.json
packages/*/package-lock.json

# ----- Storybook --------------------------------------------
storybook-static/

# ----- Playwright / Cypress E2E -----------------------------
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# ----- Miscellaneous ----------------------------------------
.vercel/
.netlify/
.firebase/
.amplify/
