# ============================================================
# Tally.io Frontend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# Backend API base URL (proxy in development, full URL in production)
VITE_API_BASE_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
# Optional: set to true to show the React Query developer panel locally.
VITE_SHOW_QUERY_DEVTOOLS=false

# App configuration
VITE_APP_NAME=Tally.io
VITE_APP_VERSION=0.1.0
