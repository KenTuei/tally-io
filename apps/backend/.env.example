# ============================================================
# Tally.io Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# ----- Application ------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ----- MongoDB Atlas ----------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tally_dev?retryWrites=true&w=majority
MONGODB_DB_NAME=tally_dev

# ----- Authentication ----------------------------------------
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET
REFRESH_TOKEN_EXPIRES_IN=7d

# ----- Redis (for BullMQ queue) -----------------------------
REDIS_URL=redis://localhost:6379

# ----- Google Sign-In ----------------------------------------
# Create a Web application OAuth client in Google Cloud Console.
# Set the same client ID in apps/frontend/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
# The ID token flow does not use a client secret or redirect callback.

# ----- M-Pesa Daraja ----------------------------------------
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=REPLACE_WITH_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=REPLACE_WITH_DARAJA_CONSUMER_SECRET
MPESA_SHORTCODE=174379
MPESA_PASSKEY=REPLACE_WITH_MPESA_PASSKEY
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/integrations/mpesa/callback

# ----- Google Gemini AI -------------------------------------
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# ----- Email ------------------------------------------------
# Provider: resend | sendgrid | console (dev — logs to stdout)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@tally.io
EMAIL_FROM_NAME=Tally.io
# Resend (recommended): get from resend.com
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
# SendGrid (alternative):
SENDGRID_API_KEY=REPLACE_WITH_SENDGRID_API_KEY

# ----- Subscription ------------------------------------------
# Set to false in development to bypass subscription restrictions
SUBSCRIPTION_ENFORCEMENT=false
DEFAULT_TRIAL_DAYS=14

# ----- Maps --------------------------------------------------
# google | mapbox | none
MAPS_PROVIDER=none
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY

# ----- Google Chat (optional) --------------------------------
GOOGLE_CHAT_WEBHOOK_URL=REPLACE_WITH_GOOGLE_CHAT_WEBHOOK_URL

# ----- KRA eTIMS (research required) -----------------------
ETIMS_ENVIRONMENT=sandbox
ETIMS_DEVICE_SERIAL=REPLACE_WITH_DEVICE_SERIAL
ETIMS_PIN=REPLACE_WITH_KRA_PIN

# ----- Logging ----------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true

# ----- Rate Limiting ----------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
